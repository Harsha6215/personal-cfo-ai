# ──────────────────────────────────────────
# Personal CFO AI — Environment Variables
# Copy this file to .env and fill in values.
# Never commit .env to version control.
# ──────────────────────────────────────────

# App
APP_ENV=local
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=personal_cfo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/personal_cfo

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=local

# AI Services (fill in for Epic 4+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
